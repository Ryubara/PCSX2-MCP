+void VMManager::ReloadDebugServer()
+{
+	// Restarts the debug server when it is switched on or off, moved to another port, or did not get its port.
+	const bool listening = DebugServer::GetPort() == EmuConfig.DebugServerPort;
+	if (EmuConfig.EnableDebugServer == DebugServer::IsRunning() && (!EmuConfig.EnableDebugServer || listening))
+		return;
+
+	DebugServer::Stop();
+
+	if (EmuConfig.EnableDebugServer)
+		DebugServer::Start(EmuConfig.DebugServerPort);
+}
